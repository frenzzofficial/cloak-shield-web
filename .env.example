# --- Backend connection --------------------------------------------------------------------
# "internal" (recommended): the browser calls this app's own /api/*, and next.config.ts proxies
# it to the backend, so the session and CSRF cookies are first-party.
NEXT_PUBLIC_API_MODE=internal

# Server-only. Where the Next server reaches the backend (no trailing slash, no /api).
#   local:       http://localhost:7164
#   production:  https://cloak-shield-app.vercel.app
API_PROXY_TARGET=http://localhost:7164

# Only for NEXT_PUBLIC_API_MODE=external (cross-origin; needs SameSite=None cookies and CORS):
# NEXT_PUBLIC_API_URL=https://cloak-shield-app.vercel.app/api

# NEXT_PUBLIC_API_TIMEOUT_MS=15000

# --- Pricing section -------------------------------------------------------------------------
# Public on purpose (a price is shown to everyone) and read at BUILD time: after changing any of
# these, redeploy. All are optional; the values below are the defaults and are PLACEHOLDERS.
# Plan names and feature lists live in src/packages/configs/price.config.ts.
# NEXT_PUBLIC_PRICE_CURRENCY=USD            # ISO code: USD, INR, EUR, ...
# NEXT_PUBLIC_PRICE_LOCALE=en-US            # number format: en-US, en-IN, de-DE, ...
# NEXT_PUBLIC_PRICE_DEFAULT_PERIOD=monthly  # monthly | yearly: which toggle is selected first
# NEXT_PUBLIC_PRICE_STARTER_MONTHLY=0
# NEXT_PUBLIC_PRICE_STARTER_YEARLY=0
# NEXT_PUBLIC_PRICE_PRO_MONTHLY=19
# NEXT_PUBLIC_PRICE_PRO_YEARLY=190          # set below MONTHLY x 12 to show a "Save %" badge
# NEXT_PUBLIC_PRICE_SALES_EMAIL=            # Enterprise "Contact us" opens mail to this address
